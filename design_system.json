{
  "name": "ASRI Collection Design System",
  "version": "1.1.0",
  "description": "Modern, minimal, premium ecommerce storefront design system",
  "framework": {
    "library": "React",
    "language": "TypeScript",
    "bundler": "Vite",
    "styling": "Tailwind CSS",
    "icons": "lucide-react"
  },
  "brand": {
    "name": "ASRI Collection",
    "tagline": "Tampil Elegan, Setiap Hari"
  },
  "designPrinciples": [
    "Modern",
    "Minimal",
    "Premium",
    "Clean",
    "Elegant",
    "Trustworthy",
    "MobileFirst"
  ],
  "platform": {
    "type": "ecommerce-storefront",
    "layout": "mobile-first",
    "responsivePriority": "mobile",
    "checkout": "guest-checkout",
    "authentication": false
  },
  "colors": {
    "primary": {
      "DEFAULT": "#16803D",
      "hover": "#146C35",
      "active": "#115C2E",
      "light": "#DCFCE7",
      "foreground": "#FFFFFF"
    },
    "neutral": {
      "black": "#171A21",
      "white": "#FFFFFF",
      "gray50": "#F8FAFC",
      "gray100": "#F1F5F9",
      "gray200": "#E5E7EB",
      "gray300": "#CBD5E1",
      "gray500": "#64748B",
      "gray400": "#94A3B8"
    },
    "background": {
      "DEFAULT": "#F8FAFC",
      "subtle": "#F1F5F9"
    },
    "surface": {
      "DEFAULT": "#FFFFFF",
      "elevated": "#FFFFFF",
      "muted": "#F8FAFC"
    },
    "text": {
      "primary": "#171A21",
      "secondary": "#64748B",
      "muted": "#64748B",
      "inverse": "#FFFFFF"
    },
    "border": {
      "DEFAULT": "#E5E7EB",
      "strong": "#CBD5E1",
      "focus": "#16803D"
    },
    "status": {
      "success": "#16A34A",
      "warning": "#F59E0B",
      "error": "#EF4444",
      "info": "#3B82F6"
    }
  },
  "typography": {
    "fontFamily": {
      "primary": "Inter",
      "fallback": [
        "system-ui",
        "-apple-system",
        "sans-serif"
      ]
    },
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "scale": {
      "display": {
        "fontSize": "30px",
        "lineHeight": "38px",
        "fontWeight": 700
      },
      "h1": {
        "fontSize": "24px",
        "lineHeight": "32px",
        "fontWeight": 700
      },
      "h2": {
        "fontSize": "20px",
        "lineHeight": "28px",
        "fontWeight": 600
      },
      "h3": {
        "fontSize": "18px",
        "lineHeight": "26px",
        "fontWeight": 600
      },
      "body": {
        "fontSize": "14px",
        "lineHeight": "22px",
        "fontWeight": 400
      },
      "small": {
        "fontSize": "12px",
        "lineHeight": "18px",
        "fontWeight": 400
      },
      "caption": {
        "fontSize": "11px",
        "lineHeight": "16px",
        "fontWeight": 400
      }
    }
  },
  "spacing": {
    "unit": "4px",
    "scale": {
      "xs": "4px",
      "sm": "8px",
      "md": "12px",
      "base": "16px",
      "lg": "20px",
      "xl": "24px",
      "2xl": "32px",
      "3xl": "40px",
      "4xl": "48px"
    }
  },
  "layout": {
    "global": {
      "boxSizing": "border-box",
      "html": {
        "width": "100%",
        "height": "100%"
      },
      "body": {
        "width": "100%",
        "height": "100%",
        "margin": "0",
        "overflow": "hidden"
      },
      "root": {
        "width": "100%",
        "height": "100%"
      }
    },
    "appShell": {
      "display": "flex",
      "flexDirection": "column",
      "width": "100%",
      "height": "100%",
      "minHeight": "0",
      "overflow": "hidden"
    },
    "header": {
      "flexShrink": "0"
    },
    "main": {
      "display": "flex",
      "flexDirection": "column",
      "flex": "1 1 0%",
      "minHeight": "0",
      "minWidth": "0"
    },
    "content": {
      "display": "flex",
      "flexDirection": "column",
      "flex": "1 1 0%",
      "minHeight": "0",
      "minWidth": "0",
      "overflowY": "auto",
      "overflowX": "hidden",
      "overscrollBehaviorY": "contain",
      "webkitOverflowScrolling": "touch"
    },
    "activePage": {
      "width": "100%",
      "minWidth": "0",
      "flexShrink": "0"
    },
    "bottomNavigation": {
      "flexShrink": "0",
      "position": "static"
    },
    "standaloneShell": {
      "display": "flex",
      "flexDirection": "column",
      "width": "100%",
      "height": "100%",
      "minHeight": "0",
      "overflow": "hidden"
    },
    "scrollPolicy": {
      "primaryScrollContainer": "content",
      "bodyScroll": false,
      "avoidNestedScrollContainers": true,
      "percentageHeightRequiresDefinedParentHeight": true,
      "viewportUnitsAllowedForShellHeight": false
    },
    "container": {
      "width": "100%",
      "maxWidth": {
        "mobile": "100%",
        "tablet": "100%",
        "desktop": "1280px"
      },
      "paddingHorizontal": {
        "mobile": "16px",
        "tablet": "24px",
        "desktop": "32px"
      },
      "marginInline": "auto"
    },
    "breakpoints": {
      "mobile": {
        "minWidth": "0px",
        "maxWidth": "639px",
        "productGridColumns": 2
      },
      "tablet": {
        "minWidth": "640px",
        "maxWidth": "1023px",
        "productGridColumns": 3
      },
      "desktop": {
        "minWidth": "1024px",
        "productGridColumns": 4
      }
    },
    "grid": {
      "display": "grid",
      "gap": "12px",
      "columnsByBreakpoint": {
        "mobile": 2,
        "tablet": 3,
        "desktop": 4
      }
    },
    "productImage": {
      "aspectRatio": "1 / 1",
      "objectFit": "cover"
    },
    "sections": {
      "verticalSpacing": "24px"
    }
  },
  "radius": {
    "none": "0px",
    "sm": "6px",
    "md": "10px",
    "button": "12px",
    "card": "14px",
    "lg": "16px",
    "xl": "20px",
    "full": "9999px"
  },
  "shadows": {
    "none": "none",
    "sm": "0 1px 2px rgba(0,0,0,0.05)",
    "md": "0 4px 12px rgba(0,0,0,0.06)",
    "lg": "0 8px 24px rgba(0,0,0,0.08)"
  },
  "components": {
    "header": {
      "height": "56px",
      "background": "colors.surface.DEFAULT",
      "flexShrink": "0"
    },
    "searchBar": {
      "height": "44px",
      "radius": "10px",
      "background": "colors.background.subtle"
    },
    "button": {
      "height": "44px",
      "radius": "12px",
      "fontSize": "14px",
      "fontWeight": 600,
      "minimumTouchTarget": "44px"
    },
    "productCard": {
      "background": "colors.surface.DEFAULT",
      "radius": "14px",
      "imageRatio": "1 / 1",
      "imagePosition": "top",
      "showName": true,
      "showPrice": true,
      "showDiscount": true,
      "showWishlist": true
    },
    "categoryItem": {
      "imageRatio": "1 / 1",
      "radius": "12px"
    },
    "bottomNavigation": {
      "height": "64px",
      "position": "static",
      "flexShrink": "0",
      "background": "colors.surface.DEFAULT"
    },
    "bottomDrawer": {
      "radiusTop": "20px",
      "background": "colors.surface.DEFAULT"
    },
    "modal": {
      "radius": "16px",
      "background": "colors.surface.DEFAULT"
    },
    "badge": {
      "radius": "6px",
      "fontSize": "11px"
    },
    "formInput": {
      "minimumHeight": "44px",
      "radius": "10px",
      "background": "colors.surface.DEFAULT",
      "border": "colors.border.DEFAULT"
    },
    "productGallery": {
      "imageRatio": "1 / 1",
      "objectFit": "cover",
      "thumbnailGap": "8px"
    },
    "quantitySelector": {
      "minimumTouchTarget": "44px",
      "buttonSize": "44px"
    },
    "productVariantSelector": {
      "minimumTouchTarget": "44px",
      "selectedBorder": "colors.primary.DEFAULT"
    },
    "cartItem": {
      "imageRatio": "1 / 1",
      "gap": "12px"
    },
    "priceDisplay": {
      "currentFontWeight": 700,
      "originalTextDecoration": "line-through"
    },
    "loading": {
      "strategy": "skeleton",
      "showDummyProducts": false
    },
    "emptyState": {
      "alignment": "center",
      "showIllustration": true
    },
    "toast": {
      "position": "top",
      "duration": "200ms"
    }
  },
  "interaction": {
    "touchTarget": {
      "minimumWidth": "44px",
      "minimumHeight": "44px"
    },
    "focusRing": {
      "color": "colors.primary.DEFAULT",
      "width": "2px",
      "style": "solid",
      "offset": "2px"
    },
    "transition": {
      "duration": "200ms",
      "easing": "ease-in-out"
    },
    "reducedMotion": {
      "respectUserPreference": true,
      "disableNonEssentialMotion": true,
      "allowEssentialStateTransitions": true
    },
    "states": [
      "default",
      "hover",
      "active",
      "focus",
      "disabled",
      "loading",
      "error",
      "empty",
      "success"
    ]
  },
  "loading": {
    "strategy": "skeleton",
    "showDummyProducts": false,
    "skeletonAnimation": "pulse",
    "disableAnimationWhenReducedMotion": true
  },
  "accessibility": {
    "standard": "WCAG 2.2 AA",
    "semanticHTML": true,
    "keyboardNavigation": true,
    "visibleFocus": true,
    "minimumTouchTarget": "44px",
    "respectReducedMotion": true,
    "colorIsNotSoleIndicator": true,
    "formControlsRequireLabels": true,
    "validationMessagesMustBeProgrammaticallyAssociated": true,
    "textContrastMinimum": "4.5:1",
    "largeTextContrastMinimum": "3:1",
    "nonTextContrastMinimum": "3:1"
  },
  "icons": {
    "library": "lucide-react",
    "strokeWidth": 1.8,
    "style": "outline"
  },
  "imagery": {
    "style": "clean-product-photography",
    "productAspectRatio": "1 / 1",
    "objectFit": "cover",
    "background": "colors.background.DEFAULT"
  },
  "tailwind": {
    "sourceOfTruth": "colors",
    "colorAliases": {
      "primary": "colors.primary.DEFAULT",
      "primary-hover": "colors.primary.hover",
      "primary-foreground": "colors.primary.foreground",
      "background": "colors.background.DEFAULT",
      "background-subtle": "colors.background.subtle",
      "surface": "colors.surface.DEFAULT",
      "text-primary": "colors.text.primary",
      "text-secondary": "colors.text.secondary",
      "border": "colors.border.DEFAULT",
      "border-strong": "colors.border.strong",
      "focus": "colors.border.focus",
      "success": "colors.status.success",
      "warning": "colors.status.warning",
      "error": "colors.status.error",
      "info": "colors.status.info"
    },
    "spacingSource": "spacing.scale",
    "radiusSource": "radius",
    "shadowSource": "shadows"
  }
}